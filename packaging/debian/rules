#!/usr/bin/make -f
# -*- makefile -*-

%:
	dh $@

binary:
	GOPATH=$(shell pwd) \
		GO111MODULE=off \
		HOME=$(shell pwd) \
		GOAMD64=v1 \
		CGO_CFLAGS="-O2 -march=x86-64 -mtune=generic" \
		CGO_CXXFLAGS="-O2 -march=x86-64 -mtune=generic" \
		src/github.com/liquidgecka/homehub/packaging/scripts/build -B VERSION
	dh $@

binary-arch:
	GOPATH=$(shell pwd) \
		GO111MODULE=off \
		HOME=$(shell pwd) \
		GOAMD64=v1 \
		CGO_CFLAGS="-O2 -march=x86-64 -mtune=generic" \
		CGO_CXXFLAGS="-O2 -march=x86-64 -mtune=generic" \
		src/github.com/liquidgecka/homehub/packaging/scripts/build -B VERSION
	dh $@
